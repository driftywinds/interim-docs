# Cloudflare Pages headers for the built documentation site.
# This file is copied verbatim from docs/ into the build output.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: browsing-topics=()

# Theme assets carry a content hash in their filename.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The search index changes with every build.
/search/*
  Cache-Control: public, max-age=0, must-revalidate

# Pages are revalidated so a new deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
